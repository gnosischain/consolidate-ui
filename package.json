{
	"name": "consolidate-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"clean": "rimraf .next node_modules **/*.tsbuildinfo",
		"audit": "pnpm audit --audit-level=high",
		"prepare": "husky"
	},
	"lint-staged": {
		"**/*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"**/*.{json,jsonc,css,scss,md,mdx,mjs,cjs,js,yml,yaml,html}": "prettier --write"
	},
	"dependencies": {
		"@safe-global/safe-apps-provider": "0.18.6",
		"@safe-global/safe-apps-sdk": "9.1.0",
		"@t3-oss/env-nextjs": "0.13.11",
		"@tailwindcss/postcss": "4.3.3",
		"@tanstack/react-query": "5.102.8",
		"dotenv": "16.6.1",
		"lucide-react": "0.544.0",
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hot-toast": "2.6.0",
		"tailwindcss": "4.3.3",
		"viem": "2.56.5",
		"wagmi": "3.7.7",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.0",
		"@commitlint/config-conventional": "21.2.0",
		"@eslint/js": "9.39.4",
		"@next/eslint-plugin-next": "16.3.5",
		"@types/node": "22.19.11",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"daisyui": "5.6.10",
		"eslint": "9.39.4",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "16.5.0",
		"husky": "9.1.7",
		"lint-staged": "17.0.8",
		"prettier": "3.9.4",
		"prettier-plugin-tailwindcss": "0.8.0",
		"rimraf": "6.1.3",
		"typescript": "5.7.3",
		"typescript-eslint": "8.62.1"
	},
	"packageManager": "pnpm@10.10.0"
}
